# Client (Vite) — point at the multiplayer host peers can reach
VITE_SOCKET_URL=http://127.0.0.1:9402

# Server
PORT=9402
# Use * or omit in dev so LAN friends can connect from other origins
CLIENT_ORIGIN=*
# Fallback seed when client omits one (client usually sends explicit/random seed)
WORLD_SEED=mrpg-realms-dev

# Optional voice transcription provider. Keep credentials server-side and out of Git.
VOICE_PROVIDER=disabled
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
